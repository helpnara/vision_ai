# 이 파일을 secrets.toml로 복사해서 값을 채운다. secrets.toml은 .gitignore 대상이다.
#
# Community Cloud에 배포할 때는 파일을 올리지 말고
# 앱 설정 화면(Settings → Secrets)에 아래 내용을 붙여넣는다.
#
# Streamlit은 최상위 문자열/숫자 시크릿을 서버 기동 시 환경변수로도 올려준다
# (streamlit/web/bootstrap.py 에서 secrets 를 먼저 읽는다).
# 그래서 애플리케이션 코드가 os.environ만 읽어도 아래 키가 그대로 전달된다.

# 3단계 "Claude 2차 판정" 기능에만 쓰인다. 없어도 나머지 기능은 전부 동작한다.
ANTHROPIC_API_KEY = "sk-ant-..."
